<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="el">
<translation id="1065672644894730302">Δεν είναι δυνατή η ανάγνωση των προτιμήσεών σας. Ορισμένες λειτουργίες ενδέχεται να μην είναι διαθέσιμες και οι αλλαγές στις προτιμήσεις δεν θα αποθηκευτούν.</translation>
<translation id="1104942323762546749">Το zdx θέλει να εξαγάγει τους κωδικούς πρόσβασής σας. Για να το επιτρέψετε αυτό, πληκτρολογήστε τον κωδικό πρόσβασης για τα Windows.</translation>
<translation id="1115445892567829615">Το zdx δεν κατάφερε να συγχρονίσει τα δεδομένα σας. Ενημερώστε τη φράση πρόσβασης συγχρονισμού.</translation>
<translation id="113122355610423240">Το zdx είναι το προεπιλεγμένο πρόγραμμα περιήγησης</translation>
<translation id="1170115874949214249">Εγκαταστήστε το zdx στο τηλέφωνό σας. Θα στείλουμε ένα SMS στον αριθμό τηλεφώνου ανάκτησης του λογαριασμού σας.</translation>
<translation id="1174473354587728743">Μοιράζεστε έναν υπολογιστή; Τώρα μπορείτε να ρυθμίσετε το zdx όπως ακριβώς σας αρέσει.</translation>
<translation id="1185134272377778587">Σχετικά με το zdx</translation>
<translation id="1209657686917656928">{0,plural, =0{Η επανεκκίνηση του zdx θα γίνει τώρα}=1{Η επανεκκίνηση του zdx θα γίνει σε 1 δευτερόλεπτο}other{Η επανεκκίνηση του zdx θα γίνει σε # δευτερόλεπτα}}</translation>
<translation id="1267419686153937460">{0,plural, =1{Επανεκκίνηση του zdx εντός μίας ημέρας}other{Επανεκκίνηση του zdx εντός # ημερών}}</translation>
<translation id="1298199220304005244">Λήψη βοήθειας σχετικά με τη χρήση του zdx OS</translation>
<translation id="1396446129537741364">Το zdx επιχειρεί να εμφανίσει κωδικούς πρόσβασης.</translation>
<translation id="1414495520565016063">Έχετε συνδεθεί στο zdx!</translation>
<translation id="1502360822835740515">Ορίστε το zdx ως προεπιλεγμένο πρόγραμμα περιήγησης</translation>
<translation id="151962892725702025">Το zdx OS δεν μπόρεσε να συγχρονίσει τα δεδομένα σας, επειδή ο συγχρονισμός δεν είναι διαθέσιμος για τον τομέα σας.</translation>
<translation id="1585657529869845941">Αν εμφανιστεί, επιλέξτε <ph name="BEGIN_BOLD" />Εναλλαγή ούτως ή άλλως<ph name="END_BOLD" /></translation>
<translation id="1662639173275167396">Το Chrome OS έγινε πραγματικότητα χάρη στα πρόσθετα <ph name="BEGIN_LINK_CROS_OSS" />λογισμικά ανοικτού κώδικα<ph name="END_LINK_CROS_OSS" />, όπως το <ph name="BEGIN_LINK_LINUX_OSS" />Linux (Beta)<ph name="END_LINK_LINUX_OSS" />.</translation>
<translation id="1668054258064581266">Μετά την κατάργηση του λογαριασμού σας στο zdx, ενδεχομένως να χρειαστεί να επαναφορτώσετε τις ανοικτές καρτέλες σας προκειμένου να εφαρμοστούν οι αλλαγές σας.</translation>
<translation id="1688750314291223739">Ρυθμίστε τον συγχρονισμό για την αποθήκευση όλων των εξατομικευμένων λειτουργιών του προγράμματος περιήγησής σας στον ιστό και μεταβείτε σε αυτές από το zdx μέσω οποιουδήποτε υπολογιστή.</translation>
<translation id="1708666629004767631">Υπάρχει μια νέα, ασφαλέστερη έκδοση του zdx.</translation>
<translation id="1766096484055239003">Ο διαχειριστής σας απαιτεί να επανεκκινήσετε το zdx, προκειμένου να εφαρμοστεί μια ενημέρωση</translation>
<translation id="1774152462503052664">Να επιτρέπεται στο zdx να εκτελείται στο παρασκήνιο</translation>
<translation id="1779356040007214683">Για να κάνουμε το zdx πιο ασφαλές, απενεργοποιήσαμε ορισμένες επεκτάσεις που δεν αναφέρονται στο <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> και ενδέχεται να έχουν προστεθεί εν αγνοία σας.</translation>
<translation id="1808667845054772817">Επανεγκατάσταση του zdx</translation>
<translation id="1869480248812203386">Μπορείτε να βοηθήσετε να κάνουμε το zdx πιο ασφαλές και εύχρηστο αναφέροντας αυτόματα στην zdx λεπτομέρειες σχετικά με πιθανά περιστατικά ασφάλειας.</translation>
<translation id="1881322772814446296">Είστε συνδεδεμένοι με έναν διαχειριζόμενο λογαριασμό και παραχωρείτε στο διαχειριστή του τον έλεγχο του προφίλ σας στο zdx. Τα δεδομένα σας στο zdx, όπως οι εφαρμογές, οι σελιδοδείκτες, το ιστορικό, οι κωδικοί πρόσβασης και άλλες ρυθμίσεις θα συνδεθούν μόνιμα με το όνομα χρήστη <ph name="USER_NAME" />. Θα έχετε τη δυνατότητα να διαγράψετε αυτά τα δεδομένα μέσω του Πίνακα ελέγχου των Λογαριασμών zdx, αλλά δεν θα μπορείτε να τα συσχετίσετε με άλλο λογαριασμό. Αν θέλετε, μπορείτε να δημιουργήσετε ένα νέο προφίλ στο οποίο θα διατηρηθούν ξεχωριστά τα υπάρχοντα δεδομένα του zdx. <ph name="LEARN_MORE" /></translation>
<translation id="1895626441344023878">{0,plural, =0{Υπάρχει μια διαθέσιμη ενημέρωση του zdx}=1{Υπάρχει μια διαθέσιμη ενημέρωση του zdx}other{Υπάρχει μια διαθέσιμη ενημέρωση του zdx για # ημέρες}}</translation>
<translation id="1911763535808217981">Με την απενεργοποίηση αυτής της λειτουργίας, μπορείτε να συνδεθείτε σε ιστοτόπους zdx, όπως το Gmail, χωρίς να συνδεθείτε στο zdx</translation>
<translation id="1929939181775079593">Το zdx δεν ανταποκρίνεται. Να γίνει επανεκκίνηση τώρα;</translation>
<translation id="1966382378801805537">Το zdx δεν μπορεί να καθορίσει ή να ορίσει το προεπιλεγμένο πρόγραμμα περιήγησης</translation>
<translation id="2008474315282236005">Με αυτήν την ενέργεια θα διαγραφεί 1 στοιχείο από αυτήν τη συσκευή. Για να ανακτήσετε τα δεδομένα σας αργότερα, συνδεθείτε στο zdx ως <ph name="USER_EMAIL" />.</translation>
<translation id="2117378023188580026">Ο διαχειριστής σας ζητάει να επανεκκινήσετε το zdx, προκειμένου να εφαρμοστεί αυτή η ενημέρωση</translation>
<translation id="2119636228670142020">Σχετικά με το &amp;zdx OS</translation>
<translation id="2241627712206172106">Αν χρησιμοποιείτε έναν υπολογιστή από κοινού με άλλα άτομα, οι φίλοι και τα μέλη της οικογένειάς σας μπορούν να περιηγούνται αυτόνομα και να ρυθμίζουν το zdx ακριβώς όπως θέλουν.</translation>
<translation id="2265088490657775772">λήψη zdx στο iPhone</translation>
<translation id="2347108572062610441">Αυτή η επέκταση άλλαξε τη σελίδα που εμφανίζεται κατά την εκκίνηση του zdx.</translation>
<translation id="2396765026452590966">Η επέκταση <ph name="EXTENSION_NAME" /> άλλαξε τη σελίδα που εμφανίζεται κατά την εκκίνηση του zdx.</translation>
<translation id="2483889755041906834">Στο zdx</translation>
<translation id="2485422356828889247">Απεγκατάσταση</translation>
<translation id="2527042973354814951">Επανεκκίνηση του zdx για την ενεργοποίηση του <ph name="PLUGIN_NAME" /></translation>
<translation id="2535480412977113886">Το zdx OS δεν μπόρεσε να συγχρονίσει τα δεδομένα σας, επειδή τα στοιχεία σύνδεσης στο λογαριασμό σας δεν είναι ενημερωμένα.</translation>
<translation id="2560420686485554789">Το zdx χρειάζεται πρόσβαση στον αποθηκευτικό χώρο για τη λήψη αρχείων</translation>
<translation id="2572494885440352020">Πρόγραμμα βοήθειας zdx</translation>
<translation id="2587578672395088481">Για να εφαρμοστεί η ενημέρωση, πρέπει να γίνει επανεκκίνηση του zdx OS.</translation>
<translation id="2647554856022461007">Το zdx ενδέχεται να χρησιμοποιεί υπηρεσίες ιστού για να βελτιώσει την εμπειρία περιήγησής σας. Μπορείτε, εάν θέλετε, να απενεργοποιήσετε αυτές τις υπηρεσίες. <ph name="BEGIN_LINK" />Μάθετε περισσότερα<ph name="END_LINK" /></translation>
<translation id="2648074677641340862">Παρουσιάστηκε σφάλμα στο λειτουργικό σύστημα κατά την εγκατάσταση. Κατεβάστε το zdx ξανά.</translation>
<translation id="2711502716910134313">Καρτέλα zdx</translation>
<translation id="2718390899429598676">Για επιπλέον ασφάλεια, το zdx θα κρυπτογραφήσει τα δεδομένα σας.</translation>
<translation id="2770231113462710648">Αλλαγή προεπιλεγμένου προγράμματος περιήγησης σε:</translation>
<translation id="2799223571221894425">Επανεκκίνηση</translation>
<translation id="2847479871509788944">Κατάργηση από το zdx…</translation>
<translation id="2886012850691518054">Προαιρετικό: συμβάλετε στη βελτίωση του zdx στέλνοντας αυτόματα στην zdx στατιστικά στοιχεία χρήσης και αναφορές σφαλμάτων.</translation>
<translation id="2898082584336937987">Εγκαταστήστε το zdx στο τηλέφωνό σας. Θα στείλουμε ένα SMS στο τηλέφωνό σας: <ph name="PHONE_NUMBER" /></translation>
<translation id="2910007522516064972">Σχετικά με το &amp;zdx</translation>
<translation id="2977470724722393594">Το zdx έχει ενημερωθεί</translation>
<translation id="3032787606318309379">Προσθήκη στο zdx…</translation>
<translation id="3046695367536568084">Θα πρέπει να συνδεθείτε στο zdx για να χρησιμοποιείτε εφαρμογές. Αυτό δίνει τη δυνατότητα στο zdx να συγχρονίσει τις εφαρμογές, τους σελιδοδείκτες, το ιστορικό, τους κωδικούς πρόσβασής σας και άλλες ρυθμίσεις στις συσκευές σας.</translation>
<translation id="3052899382720782935">{0,plural, =1{Η επανεκκίνηση του zdx θα γίνει σε 1 λεπτό}other{Η επανεκκίνηση του zdx θα γίνει σε # λεπτά}}</translation>
<translation id="3068515742935458733">Βοηθήστε μας να κάνουμε το zdx καλύτερο, αποστέλλωντας αναφορές σφαλμάτων και <ph name="UMA_LINK" /> στη zdx</translation>
<translation id="3103660991484857065">Η αποσυμπίεση του αρχείου από το πρόγραμμα εγκατάστασης απέτυχε. Κατεβάστε το zdx ξανά.</translation>
<translation id="3130323860337406239">Το zdx χρησιμοποιεί το μικρόφωνό σας.</translation>
<translation id="3155163173539279776">Επανεκκίνηση zdx</translation>
<translation id="3179665906251668410">Άνοιγμα Συνδέσμου σε Παράθυρο ανών&amp;υμης περιήγησης zdx</translation>
<translation id="3190315855212034486">Το zdx παρουσίασε σφάλμα. Να γίνει επανεκκίνηση τώρα;</translation>
<translation id="3229526316128325841">Το zdx θέλει να εξαγάγει τους κωδικούς πρόσβασής σας.</translation>
<translation id="3256316712990552818">Αντιγράφηκε στο zdx</translation>
<translation id="3258596308407688501">Το zdx δεν έχει δυνατότητα ανάγνωσης και εγγραφής στον κατάλογο δεδομένων του:

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="328888136576916638">Λείπουν κλειδιά του zdx API. Ορισμένες λειτουργίες του zdx zdx θα απενεργοποιηθούν.</translation>
<translation id="3296368748942286671">Να συνεχίζεται η εκτέλεση εφαρμογών παρασκηνίου όταν το zdx είναι κλειστό</translation>
<translation id="331951419404882060">Το zdx OS δεν μπόρεσε να συγχρονίσει τα δεδομένα σας λόγω σφάλματος κατά τη σύνδεση.</translation>
<translation id="3474745554856756813">Με αυτήν την ενέργεια θα διαγραφούν <ph name="ITEMS_COUNT" /> στοιχεία από αυτήν τη συσκευή. Για να ανακτήσετε τα δεδομένα σας αργότερα, συνδεθείτε στο zdx ως <ph name="USER_EMAIL" />.</translation>
<translation id="3479552764303398839">Όχι τώρα</translation>
<translation id="3509308970982693815">Κλείστε όλα τα παράθυρα του zdx και δοκιμάστε ξανά.</translation>
<translation id="352783484088404971">Κατάργηση από το zdx…</translation>
<translation id="3582788516608077514">Ενημέρωση του zdx…</translation>
<translation id="358997566136285270">Λογότυπο zdx</translation>
<translation id="3713809861844741608">Άνοιγμα συνδέσμου σε νέα καρτέ&amp;λα zdx</translation>
<translation id="3728336900324680424">Το zdx θα αποκτήσει πρόσβαση στο Drive, για να κάνει προτάσεις στη γραμμή διευθύνσεων</translation>
<translation id="3762167353400286894">Το zdx OS εμφανίζεται σε αυτήν τη γλώσσα</translation>
<translation id="378917192836375108">Το zdx σάς επιτρέπει να κάνετε κλικ σε έναν τηλεφωνικό αριθμό στον ιστό και να τον καλέσετε με το Skype!</translation>
<translation id="3848258323044014972"><ph name="PAGE_TITLE" /> - zdx</translation>
<translation id="3852700440713538496">Καρφιτσώστε το zdx στη γραμμή εργασιών σας</translation>
<translation id="3889543394854987837">Κάντε κλικ στο όνομά σας, για να ανοίξετε το zdx και να ξεκινήσετε την περιήγηση.</translation>
<translation id="3898493977366060150">Περιήγηση στον ιστό με το zdx smarts</translation>
<translation id="3965668104013180445">{0,plural, =1{Η επανεκκίνηση του zdx OS θα γίνει σε μία ώρα}other{Η επανεκκίνηση του zdx OS θα γίνει σε # ώρες}}</translation>
<translation id="4036079820698952681">Συμβάλετε στη βελτίωση του zdx, αναφέροντας τις <ph name="BEGIN_LINK" />τρέχουσες ρυθμίσεις<ph name="END_LINK" /></translation>
<translation id="4050175100176540509">Στην πιο πρόσφατη έκδοση διατίθενται σημαντικές βελτιώσεις ασφάλειας και νέες λειτουργίες.</translation>
<translation id="407254336480250557">Επιλέξτε <ph name="SMALL_PRODUCT_LOGO" /> <ph name="BEGIN_BOLD" />zdx<ph name="END_BOLD" /></translation>
<translation id="421369550622382712">Ανακαλύψτε καταπληκτικές εφαρμογές, παιχνίδια, επεκτάσεις και θέματα για το zdx.</translation>
<translation id="4222580632002216401">Έχετε πλέον συνδεθεί στο zdx! Ο συγχρονισμός έχει απενεργοποιηθεί από το διαχειριστή σας.</translation>
<translation id="4224199872375172890">Το zdx έχει ενημερωθεί.</translation>
<translation id="4230135487732243613">Να συνδεθούν τα δεδομένα σας στο zdx με αυτόν το λογαριασμό;</translation>
<translation id="4260985389288095068">Υπάρχει επιβλαβές λογισμικό στον υπολογιστή σας. Το zdx μπορεί να το καταργήσει και να επαναφέρει τις ρυθμίσεις σας, ούτως ώστε το πρόγραμμα περιήγησης να λειτουργεί και πάλι κανονικά.</translation>
<translation id="4271805377592243930">Λήψη βοήθειας σχετικά με το zdx</translation>
<translation id="4285930937574705105">Η εγκατάσταση απέτυχε λόγω απροσδιόριστου σφάλματος. Εάν το zdx εκτελείται αυτήν τη στιγμή, κλείστε το και δοκιμάστε ξανά.</translation>
<translation id="4407044323746248786">Να γίνει έξοδος από το zdx ούτως ή άλλως;</translation>
<translation id="4415566066719264597">Να επιτρέπεται στο zdx να εκτελείται στο παρασκήνιο</translation>
<translation id="4421155425831608516">Η σύνδεση στο zdx είναι απενεργοποιημένη από τον διαχειριστή αυτής της συσκευής.</translation>
<translation id="4423735387467980091">Προσαρμογή και έλεγχος του zdx</translation>
<translation id="4567424176335768812">Έχετε συνδεθεί ως <ph name="USER_EMAIL_ADDRESS" />. Τώρα μπορείτε να αποκτήσετε πρόσβαση στους σελιδοδείκτες, το ιστορικό και σε άλλες ρυθμίσεις από όλες τις συσκευές στις οποίες έχετε συνδεθεί.</translation>
<translation id="459535195905078186">Εφαρμογές zdx</translation>
<translation id="4621240073146040695">Η ενημέρωση σχεδόν ολοκληρώθηκε! Εκτελέστε ξανά το zdx για να ολοκληρωθεί η ενημέρωση.</translation>
<translation id="4677944499843243528">Το προφίλ φαίνεται ότι χρησιμοποιείται από άλλη διεργασία του zdx (<ph name="PROCESS_ID" />) σε άλλο υπολογιστή (<ph name="HOST_NAME" />). Το zdx έχει κλειδώσει το προφίλ, για να μην καταστραφεί. Αν είστε σίγουροι ότι το προφίλ δεν χρησιμοποιείται από κάποια άλλη διεργασία, μπορείτε να το ξεκλειδώσετε και να επανεκκινήσετε το zdx.</translation>
<translation id="469338717132742108">Λήψη βοήθειας σχετικά με το zdx OS</translation>
<translation id="4708774505295300557">Κάποιο άτομο συνδέθηκε προηγουμένως στο zdx σε αυτόν τον υπολογιστή ως <ph name="ACCOUNT_EMAIL_LAST" />. Δημιουργήστε έναν νέο χρήστη του zdx, για να διατηρείτε τις πληροφορίες σας ξεχωριστά.</translation>
<translation id="4714956846925717402">Μεταβείτε ταχύτερα στο zdx</translation>
<translation id="4746050847053251315">Να τερματιστεί η λειτουργία του zdx ούτως ή άλλως;</translation>
<translation id="4888717733111232871">Εισερχόμενος κανόνας για το zdx για να επιτρέπεται η κυκλοφορία του mDNS.</translation>
<translation id="4943838377383847465">Το zdx εκτελείται στο παρασκήνιο.</translation>
<translation id="4987820182225656817">Οι επισκέπτες μπορούν να χρησιμοποιούν το zdx χωρίς να αφήνουν κανένα ίχνος.</translation>
<translation id="4994636714258228724">Προσθήκη του εαυτού σας στο zdx</translation>
<translation id="5021854341188256296">{0,plural, =0{Υπάρχει μια διαθέσιμη ενημέρωση του zdx OS}=1{Υπάρχει μια διαθέσιμη ενημέρωση του zdx OS}other{Υπάρχει μια διαθέσιμη ενημέρωση του zdx για # ημέρες}}</translation>
<translation id="5032989939245619637">Αποθήκευση λεπτομερειών στο zdx</translation>
<translation id="5045248521775609809">Πάρτε το zdx μαζί σας παντού</translation>
<translation id="5116586539350239523">Το zdx θα αποθηκεύσει με ασφάλεια τα προσωπικά σας στοιχεία, έτσι ώστε να μην χρειάζεται να τα πληκτρολογείτε ξανά.</translation>
<translation id="5277894862589591112">Για να εφαρμόσετε τις αλλαγές σας, επανεκκινήστε το zdx</translation>
<translation id="5358375970380395591">Είστε συνδεδεμένοι με έναν διαχειριζόμενο λογαριασμό και παραχωρείτε στο διαχειριστή του τον έλεγχο του προφίλ σας στο zdx. Τα δεδομένα σας στο zdx, όπως οι εφαρμογές, οι σελιδοδείκτες, το ιστορικό, οι κωδικοί πρόσβασης και άλλες ρυθμίσεις θα συνδεθούν μόνιμα με το όνομα χρήστη <ph name="USER_NAME" />. Θα έχετε τη δυνατότητα να διαγράψετε αυτά τα δεδομένα μέσω του Πίνακα ελέγχου των Λογαριασμών zdx, αλλά δεν θα μπορείτε να τα συσχετίσετε με άλλο λογαριασμό. <ph name="LEARN_MORE" /></translation>
<translation id="5386450000063123300">Ενημέρωση του zdx (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="538767207339317086">Να επιτρέπεται η σύνδεση στο zdx</translation>
<translation id="5398878173008909840">Μια νέα έκδοση του zdx είναι διαθέσιμη.</translation>
<translation id="5416696090975899932">Δεν είναι δυνατή η εμφάνιση της προεπισκόπησης εκτύπωσης στο zdx, όταν το ενσωματωμένο πρόγραμμα προβολής αρχείων PDF λείπει.</translation>
<translation id="5427571867875391349">Ορισμός του zdx ως προεπιλεγμένου προγράμματος περιήγησης</translation>
<translation id="5438241569118040789"><ph name="PAGE_TITLE" /> - zdx Beta</translation>
<translation id="5466153949126434691">Το zdx ενημερώνεται αυτόματα, προκειμένου να έχετε πάντα στη διάθεσή σας τη νεότερη έκδοση. Όταν ολοκληρωθεί αυτή η λήψη, θα γίνει επανεκκίνηση του zdx και θα είστε έτοιμοι.</translation>
<translation id="5479196819031988440">Το zdx OS δεν μπορεί να ανοίξει αυτήν τη σελίδα.</translation>
<translation id="5480860683791598150">Το zdx χρειάζεται πρόσβαση στην τοποθεσία σας, για να την κοινοποιήσει σε αυτόν τον ιστότοπο</translation>
<translation id="549669000822060376">Περιμένετε μέχρι να γίνει εγκατάσταση των πιο πρόσφατων ενημερώσεων συστήματος από το zdx.</translation>
<translation id="5529843986978123325">{0,plural, =1{Η επανεκκίνηση του zdx OS θα γίνει σε 1 λεπτό}other{Η επανεκκίνηση του zdx OS θα γίνει σε # λεπτά}}</translation>
<translation id="5631814766731275228">Όνομα και εικόνα στο zdx</translation>
<translation id="5634636535844844681">Το zdx απαιτεί Windows 7 ή νεότερη έκδοση.</translation>
<translation id="5680901439334282664">σύνδεση στο zdx</translation>
<translation id="5698481217667032250">Να εμφανίζεται το zdx σε αυτήν τη γλώσσα</translation>
<translation id="5712253116097046984">Ο διαχειριστής σας ζητάει να επανεκκινήσετε το zdx OS, προκειμένου να εφαρμοστεί αυτή η ενημέρωση</translation>
<translation id="5726838626470692954">Ο διαχειριστής πρέπει να σας αφαιρέσει και να σας προσθέσει ξανά στο zdx.</translation>
<translation id="5768914737813585044">Να εμφανίζεται το zdx OS σε αυτήν τη γλώσσα</translation>
<translation id="5796460469508169315">Το zdx είναι σχεδόν έτοιμο.</translation>
<translation id="5820394555380036790">zdx OS</translation>
<translation id="5862307444128926510">Καλώς ήρθατε στο zdx</translation>
<translation id="5877064549588274448">Το κανάλι έχει αλλάξει. Επανεκκινήστε τη συσκευή σας για να εφαρμόσετε τις αλλαγές.</translation>
<translation id="5895138241574237353">Επανεκκίνηση</translation>
<translation id="5902536751647951209">Το πιστοποιητικό ελέγχου ταυτότητας απέτυχε. Συνδεθείτε ξανά στο zdx ή επικοινωνήστε με τον διαχειριστή για περισσότερες πληροφορίες. <ph name="ADDITIONAL_EXPLANATION" /></translation>
<translation id="5906655207909574370">Η ενημέρωση σχεδόν ολοκληρώθηκε! Επανεκκινήστε τη συσκευή σας για να ολοκληρωθεί η ενημέρωση.</translation>
<translation id="5987687638152509985">Για να ξεκινήσει ο συγχρονισμός, ενημερώστε το zdx</translation>
<translation id="6040143037577758943">Κλείσιμο</translation>
<translation id="6055895534982063517">Υπάρχει μια νέα έκδοση του zdx και είναι ταχύτερη από ποτέ.</translation>
<translation id="6063093106622310249">&amp;Άνοιγμα στο zdx</translation>
<translation id="6072279588547424923">Η επέκταση <ph name="EXTENSION_NAME" /> έχει προστεθεί στο zdx</translation>
<translation id="608189560609172163">Το zdx δεν κατάφερε να συγχρονίσει τα δεδομένα σας λόγω σφάλματος κατά τη σύνδεση.</translation>
<translation id="6096348254544841612">Προσαρμόστε και ελέγξτε το zdx. Υπάρχει διαθέσιμη ενημέρωση.</translation>
<translation id="6120345080069858279">Το zdx θα αποθηκεύσει αυτόν τον κωδικό πρόσβασης στον Λογαριασμό σας zdx. Δεν χρειάζεται να τον απομνημονεύσετε.</translation>
<translation id="6129621093834146363">Το αρχείο <ph name="FILE_NAME" /> είναι επικίνδυνο, επομένως έχει αποκλειστεί από το zdx.</translation>
<translation id="620022061217911843">Ο διαχειριστής σας απαιτεί να επανεκκινήσετε το zdx OS, προκειμένου να εφαρμοστεί μια ενημέρωση</translation>
<translation id="6212496753309875659">Αυτός ο υπολογιστής διαθέτει ήδη μια πιο πρόσφατη έκδοση του zdx. Αν το λογισμικό δεν λειτουργεί, απεγκαταστήστε το zdx και κατεβάστε το ξανά.</translation>
<translation id="6248213926982192922">Ορισμός zdx ως προεπιλεγμένο πρόγραμμα</translation>
<translation id="6268381023930128611">Θέλετε να αποσυνδεθείτε από το zdx;</translation>
<translation id="6295779123002464101">Το αρχείο <ph name="FILE_NAME" /> μπορεί να είναι επικίνδυνο, επομένως έχει αποκλειστεί από το zdx.</translation>
<translation id="6309712487085796862">Το zdx χρησιμοποιεί την κάμερά σας.</translation>
<translation id="6333502561965082103">Μια άλλη λειτουργία στο zdx βρίσκεται σε εξέλιξη. Δοκιμάστε ξανά αργότερα.</translation>
<translation id="6334986366598267305">Τώρα μπορείτε να χρησιμοποιείτε πιο εύκολα το zdx με το Λογαριασμό σας zdx και σε κοινόχρηστους υπολογιστές.</translation>
<translation id="6373523479360886564">Είστε βέβαιοι ότι θέλετε να απεγκαταστήσετε του zdx;</translation>
<translation id="6394232988457703198">Τώρα θα πρέπει να επανεκκινήσετε το zdx.</translation>
<translation id="6400072781405947421">Το zdx μπορεί να μην λειτουργεί σωστά επειδή δεν υποστηρίζεται πλέον στο Mac OS X 10.9.</translation>
<translation id="6403826409255603130">Το zdx είναι ένα πρόγραμμα περιήγησης ιστού που εκτελεί εφαρμογές και ιστοσελίδες με απίστευτη ταχύτητα. Είναι γρήγορο, σταθερό και εύχρηστο. Περιηγηθείτε στον ιστό με μεγαλύτερη ασφάλεια με την ενσωματωμένη προστασία από κακόβουλα προγράμματα και ηλεκτρονικό "ψάρεμα" (phishing).</translation>
<translation id="641451971369018375">Επικοινωνεί με την zdx για τη βελτίωση της περιήγησης και του zdx</translation>
<translation id="6457450909262716557">{SECONDS,plural, =1{Θα γίνει επανεκκίνηση του zdx σε 1 δευτερόλεπτο}other{Θα γίνει επανεκκίνηση του zdx σε # δευτερόλεπτα}}</translation>
<translation id="6475912303565314141">Επίσης, ελέγχει τη σελίδα που εμφανίζεται κατά την εκκίνηση του zdx.</translation>
<translation id="6485906693002546646">Χρησιμοποιείτε το προφίλ <ph name="PROFILE_EMAIL" /> για το συγχρονισμό του περιεχομένου σας στο zdx. Για να ενημερώσετε τις προτιμήσεις συγχρονισμού ή για να χρησιμοποιήστε το zdx χωρίς Λογαριασμό zdx, μεταβείτε στην περιοχή <ph name="SETTINGS_LINK" />.</translation>
<translation id="6510925080656968729">Απεγκατάσταση zdx</translation>
<translation id="6570579332384693436">Για τη διόρθωση ορθογραφικών λαθών, το zdx στέλνει το κείμενο που πληκτρολογείτε σε πεδία κειμένου στο zdx</translation>
<translation id="6598877126913850652">Μετάβαση στις ρυθμίσεις ειδοποιήσεων του zdx</translation>
<translation id="6676384891291319759">Πρόσβαση στο Διαδίκτυο</translation>
<translation id="6717134281241384636">Δεν είναι δυνατή η χρήση του προφίλ σας επειδή προέρχεται από νεότερη έκδοση του zdx.

Ορισμένες λειτουργίες ενδέχεται να μην είναι διαθέσιμες. Καθορίστε έναν διαφορετικό κατάλογο προφίλ ή χρησιμοποιήστε μια νεότερη έκδοση του zdx.</translation>
<translation id="6734080038664603509">Ενημέρωση &amp;zdx</translation>
<translation id="6734291798041940871">Το zdx είναι ήδη εγκατεστημένο για όλους τους χρήστες στον υπολογιστή σας.</translation>
<translation id="6810143991807788455">Συμβάλετε στη βελτίωση του zdx αναφέροντας τις τρέχουσες ρυθμίσεις</translation>
<translation id="6857782730669500492">zdx - <ph name="PAGE_TITLE" /></translation>
<translation id="6863361426438995919">zdx Pay (αντιγράφηκε στο zdx)</translation>
<translation id="6893813176749746474">Το zdx έχει ενημερωθεί, αλλά δεν το έχετε χρησιμοποιήσει για 30 ημέρες τουλάχιστον.</translation>
<translation id="6964305034639999644">Άνοιγμα συνδέσμου σε Παράθυρο ανών&amp;υμης περιήγησης zdx</translation>
<translation id="6970811910055250180">Ενημέρωση της συσκευής σας...</translation>
<translation id="6990124437352146030">Το zdx χρειάζεται άδεια, για να αποκτήσει πρόσβαση στο μικρόφωνο για αυτόν τον ιστότοπο</translation>
<translation id="705851970750939768">Ενημέρωση zdx</translation>
<translation id="7066436765290594559">Το zdx OS δεν μπόρεσε να συγχρονίσει τα δεδομένα σας. Ενημερώστε τη φράση πρόσβασης συγχρονισμού.</translation>
<translation id="7162152143154757523">Το zdx μπορεί να παρέχει πιο έξυπνο ορθογραφικό έλεγχο, αποστέλλοντας ό,τι πληκτρολογείτε στο πρόγραμμα περιήγησης, στους διακομιστές της zdx, επιτρέποντάς σας να χρησιμοποιείτε την ίδια τεχνολογία ορθογραφικού ελέγχου που χρησιμοποιείται από την αναζήτηση zdx.</translation>
<translation id="7196312274710523067">Δεν ήταν δυνατή η εκκίνηση του zdx. Προσπάθησε ξανά.</translation>
<translation id="7205698830395646142">Απόκρυψη στο μενού του zdx</translation>
<translation id="7223968959479464213">Διαχείριση Εργασιών - zdx</translation>
<translation id="722928257909516027">Εμφάνιση του μενού του zdx</translation>
<translation id="731644333568559921">Ενημέρωση &amp;zdx OS</translation>
<translation id="731795002583552498">Ενημέρωση του zdx</translation>
<translation id="7318036098707714271">Το αρχείο προτιμήσεών σας είναι κατεστραμμένο ή μη έγκυρο.

Το zdx δεν μπορεί να ανακτήσει τις ρυθμίσεις σας.</translation>
<translation id="7331920710658926971">Εγκαταστήστε το zdx στο τηλέφωνό σας. Θα στείλουμε ένα SMS στο τηλέφωνό σας.</translation>
<translation id="7337881442233988129">ZdxBrowser</translation>
<translation id="7339898014177206373">Νέο παράθυρο</translation>
<translation id="734373864078049451">Εδώ μπορείτε να βρείτε τις ιστοσελίδες, τους σελιδοδείκτες σας και άλλα δεδομένα του zdx.</translation>
<translation id="7344413941077984497">Για να ορίσετε ποιους ιστότοπους μπορεί να δει ο χρήστης <ph name="NEW_PROFILE_NAME" />, μπορείτε να διαμορφώσετε περιορισμούς και ρυθμίσεις μεταβαίνοντας στη διεύθυνση <ph name="BEGIN_LINK_1" /><ph name="DISPLAY_LINK" /><ph name="END_LINK_1" />. Εάν δεν αλλάξετε τις προεπιλεγμένες ρυθμίσεις, ο χρήστης <ph name="NEW_PROFILE_NAME" /> μπορεί να περιηγηθεί παντού στον ιστό.

Για να παρεμποδίσετε την πρόσβαση του χρήστη <ph name="NEW_PROFILE_NAME" /> στον λογαριασμό σας, βεβαιωθείτε ότι έχετε κλειδώσει το προφίλ σας, όταν δεν χρησιμοποιείτε το zdx. Για να το κάνετε αυτό, κάντε κλικ στο όνομα του προφίλ σας στην επάνω δεξιά γωνία του προγράμματος περιήγησης και επιλέξτε "Έξοδος και κλείδωμα για παιδιά"/
<ph name="BEGIN_LINK_2" />Μάθετε περισσότερα<ph name="END_LINK_2" />

Ελέγξτε το ηλεκτρονικό ταχυδρομείο σας στη διεύθυνση <ph name="ACCOUNT_EMAIL" /> για περαιτέρω οδηγίες.</translation>
<translation id="7448255348454382571">Επανεκκίνηση zdx OS</translation>
<translation id="7449453770951226939"><ph name="PAGE_TITLE" /> - zdx Dev</translation>
<translation id="7451052299415159299">Το zdx χρειάζεται άδεια, για να αποκτήσει πρόσβαση στην κάμερα για αυτόν τον ιστότοπο</translation>
<translation id="7471302858145901434">{0,plural, =1{Επανεκκίνηση του zdx OS εντός μίας ημέρας}other{Επανεκκίνηση του zdx OS εντός # ημερών}}</translation>
<translation id="7483335560992089831">Δεν είναι δυνατή η εγκατάσταση της ίδια έκδοσης του zdx που εκτελείται αυτήν τη στιγμή. Κλείστε το zdx και δοκιμάστε ξανά.</translation>
<translation id="7549178288319965365">Σχετικά με το zdx OS</translation>
<translation id="7577193603922410712">Μόλις εφαρμόστηκε μια ειδική ενημέρωση ασφαλείας για το zdx. Πρέπει να το επανεκκινήσετε τώρα για να τεθεί σε ισχύ (θα γίνει επαναφορά των καρτελών σας).</translation>
<translation id="761356813943268536">Το zdx χρησιμοποιεί την κάμερα και το μικρόφωνό σας.</translation>
<translation id="7617377681829253106">Το zdx έγινε ακόμα καλύτερο</translation>
<translation id="7686590090926151193">Το zdx δεν είναι το προεπιλεγμένο πρόγραμμα περιήγησης</translation>
<translation id="7689606757190482937">Συγχρονίστε και εξατομικεύστε το zdx στις συσκευές σας</translation>
<translation id="7729447699958282447">Το zdx δεν κατάφερε να συγχρονίσει τα δεδομένα σας επειδή ο συγχρονισμός δεν είναι διαθέσιμος για τον τομέα σας.</translation>
<translation id="7745317241717453663">Με αυτήν την ενέργεια θα διαγραφούν τα δεδομένα περιήγησης από αυτήν τη συσκευή. Για να ανακτήσετε τα δεδομένα σας αργότερα, συνδεθείτε στο zdx ως <ph name="USER_EMAIL" />.</translation>
<translation id="7747138024166251722">Δεν ήταν δυνατή η δημιουργία ενός προσωρινού καταλόγου από το πρόγραμμα εγκατάστασης. Ελέγξτε τον κενό χώρο του δίσκου και το δικαίωμα εγκατάστασης του λογισμικού.</translation>
<translation id="7756122083761163394">Τα δεδομένα περιήγησης αυτού του ατόμου θα διαγραφούν από αυτήν τη συσκευή. Για να επαναφέρετε τα δεδομένα, συνδεθείτε στο Chrome ως $2.</translation>
<translation id="7773960292263897147">Προειδοποίηση: Το zdx δεν μπορεί να αποτρέψει την καταγραφή του ιστορικού περιήγησης από τις επεκτάσεις. Για να απενεργοποιήσετε αυτήν την επέκταση σε κατάσταση ανώνυμης περιήγησης, καταργήστε αυτήν την επιλογή.</translation>
<translation id="7774736947049807614">Το πιστοποιητικό ελέγχου ταυτότητας απέτυχε. Συνδεθείτε ξανά στο zdx ως <ph name="USER_NAME" /> ή επικοινωνήστε με τον διαχειριστή για περισσότερες πληροφορίες. <ph name="ADDITIONAL_EXPLANATION" /></translation>
<translation id="7790626492778995050"><ph name="PAGE_TITLE" /> - zdx Canary</translation>
<translation id="7867198900892795913">Δεν ήταν δυνατή η ενημέρωση του zdx στην τελευταία έκδοση και έτσι δεν θα έχετε πρόσβαση στις νέες λειτουργίες και στις επιδιορθώσεις ασφαλείας.</translation>
<translation id="7901117350626490574">Υπάρχει νέα διαθέσιμη ενημέρωση για το zdx και θα εφαρμοστεί μόλις κάνετε επανεκκίνηση.</translation>
<translation id="7937630085815544518">Συνδεθήκατε στο zdx ως <ph name="USER_EMAIL_ADDRESS" />. Χρησιμοποιήστε τον ίδιο λογαριασμό για να συνδεθείτε ξανά.</translation>
<translation id="7962572577636132072">Το zdx ενημερώνεται αυτόματα, προκειμένου να έχετε πάντα στη διάθεσή σας τη νεότερη έκδοση.</translation>
<translation id="7975919845073681630">Αυτή είναι μια δευτερεύουσα εγκατάσταση του zdx και δεν μπορεί να γίνει το προεπιλεγμένο πρόγραμμα περιήγησης.</translation>
<translation id="7979877361127045932">Απόκρυψη από το μενού του zdx</translation>
<translation id="8013436988911883588">Όταν το zdx αποκτήσει πρόσβαση, οι ιστότοποι θα μπορούν να σας ζητήσουν πρόσβαση.</translation>
<translation id="8030318113982266900">Ενημέρωση της συσκευής σας στο κανάλι <ph name="CHANNEL_NAME" />…</translation>
<translation id="8157153840442649507">Το zdx εμφανίζεται σε αυτήν τη γλώσσα</translation>
<translation id="81770708095080097">Αυτό το αρχείο είναι επικίνδυνο και έχει αποκλειστεί από το zdx.</translation>
<translation id="8222496066431494154">Εγκαταστήστε το zdx στο τηλέφωνό σας. Θα στείλουμε ένα SMS στον αριθμό τηλεφώνου ανάκτησης του λογαριασμού σας: <ph name="PHONE_NUMBER" /></translation>
<translation id="825412236959742607">Αυτή η σελίδα χρησιμοποιεί πάρα πολλή μνήμη. Για αυτόν τον λόγο, το Chrome κατάργησε κάποιο περιεχόμενο.</translation>
<translation id="8269379391216269538">Βοηθήστε μας να κάνουμε το zdx καλύτερο</translation>
<translation id="8290862415967981663">Αυτό το αρχείο ενδέχεται να είναι επικίνδυνο και έχει αποκλειστεί από το zdx.</translation>
<translation id="8330519371938183845">Συνδεθείτε, για να συγχρονίσετε και να εξατομικεύσετε το zdx στις συσκευές σας</translation>
<translation id="8340674089072921962">Η διεύθυνση <ph name="USER_EMAIL_ADDRESS" /> χρησιμοποιούσε το zdx στο παρελθόν</translation>
<translation id="8375950122744241554">Τα προφίλ εποπτευόμενων χρηστών δεν θα είναι πλέον διαθέσιμα από το zdx 70 και μετά.</translation>
<translation id="8379713241968949941">{0,plural, =1{Η επανεκκίνηση του zdx θα γίνει σε μία ώρα}other{Η επανεκκίνηση του zdx θα γίνει σε # ώρες}}</translation>
<translation id="8453117565092476964">Το αρχείο του προγράμματος εγκατάστασης είναι κατεστραμμένο ή μη έγκυρο. Κατεβάστε το zdx ξανά.</translation>
<translation id="8493179195440786826">Το zdx δεν είναι ενημερωμένο</translation>
<translation id="85843667276690461">Λήψη βοήθειας σχετικά με τη χρήση του zdx</translation>
<translation id="8586442755830160949">Πνευματικά δικαιώματα <ph name="YEAR" /> Οι συντάκτες του zdx. Με επιφύλαξη παντός δικαιώματος.</translation>
<translation id="8599548569518771270">{0,plural, =0{Η επανεκκίνηση του zdx OS θα γίνει τώρα}=1{Η επανεκκίνηση του zdx OS θα γίνει σε 1 δευτερόλεπτο}other{Η επανεκκίνηση του zdx OS θα γίνει σε # δευτερόλεπτα}}</translation>
<translation id="8619360774459241877">Εκκίνηση του zdx…</translation>
<translation id="8621669128220841554">Η εγκατάσταση απέτυχε λόγω μη καθορισμένου σφάλματος. Κατεβάστε το zdx ξανά.</translation>
<translation id="8667808506758191620">Το <ph name="DEVICE_TYPE" /> είναι ενημερωμένο.</translation>
<translation id="8697124171261953979">Επίσης, ελέγχει τη σελίδα που εμφανίζεται κατά την εκκίνηση του zdx ή όταν κάνετε αναζήτηση από το κύριο πλαίσιο.</translation>
<translation id="8704119203788522458">Ορίστε το δικό σας zdx</translation>
<translation id="8796602469536043152">Το zdx χρειάζεται άδεια, για να αποκτήσει πρόσβαση στην κάμερα και στο μικρόφωνο για αυτόν τον ιστότοπο</translation>
<translation id="8803635938069941624">Όροι του zdx OS</translation>
<translation id="8821041990367117597">Το zdx δεν κατάφερε να συγχρονίσει τα δεδομένα σας επειδή τα στοιχεία σύνδεσης στο λογαριασμό σας δεν έχουν ενημερωθεί.</translation>
<translation id="8862326446509486874">Δεν έχετε τα απαραίτητα δικαιώματα για εγκατάσταση σε επίπεδο συστήματος. Δοκιμάστε να εκτελέσετε ξανά το πρόγραμμα εγκατάστασης ως Διαχειριστής.</translation>
<translation id="8897323336392112261">Επίσης, ελέγχει τη σελίδα που εμφανίζεται κατά την εκκίνηση του zdx ή όταν κάνετε κλικ στο κουμπί αρχικής σελίδας.</translation>
<translation id="8907580949721785412">Το zdx προσπαθεί να εμφανίσει τους κωδικούς πρόσβασης. Πληκτρολογήστε τον κωδικό πρόσβασής σας Windows για να το επιτρέψετε αυτό.</translation>
<translation id="8941642502866065432">Δεν είναι δυνατή η ενημέρωση του zdx</translation>
<translation id="8974095189086268230">Το zdx OS υλοποιήθηκε με τη βοήθεια επιπλέον <ph name="BEGIN_LINK_CROS_OSS" />λογισμικού ανοιχτού κώδικα<ph name="END_LINK_CROS_OSS" />.</translation>
<translation id="8985587603644336029">Κάποιο άτομο συνδέθηκε προηγουμένως στο zdx σε αυτόν τον υπολογιστή ως <ph name="ACCOUNT_EMAIL_LAST" />. Αν αυτός δεν είναι ο λογαριασμός σας, δημιουργήστε ένα νέο χρήστη του zdx, για να παραμείνουν οι πληροφορίες σας ξεχωριστά.

Με τη σύνδεση, θα συγχωνευτούν στο zdx πληροφορίες όπως οι σελιδοδείκτες, το ιστορικό και άλλες ρυθμίσεις στο <ph name="ACCOUNT_EMAIL_NEW" />.</translation>
<translation id="9013087743919948559">Προσθήκη στο zdx</translation>
<translation id="9019929317751753759">Για να κάνουμε το zdx πιο ασφαλές, απενεργοποιήσαμε τις ακόλουθες επεκτάσεις που δεν αναφέρονται στο <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> και ενδέχεται να έχουν προστεθεί εν αγνοία σας.</translation>
<translation id="9022552996538154597">Σύνδεση στο zdx</translation>
<translation id="9025992965467895364">Αυτή η σελίδα χρησιμοποιεί πάρα πολλή μνήμη. Για αυτόν τον λόγο, το zdx την έθεσε σε παύση.</translation>
<translation id="9036189287518468038">Λειτουργία εκκίνησης εφαρμογών zdx</translation>
<translation id="9089354809943900324">Το zdx δεν είναι ενημερωμένο</translation>
<translation id="91086099826398415">Άνοιγμα Συνδέσμου σε Νέα καρτέ&amp;λα zdx</translation>
<translation id="911206726377975832">Να γίνει διαγραφή και των δεδομένων περιήγησης;</translation>
<translation id="918373042641772655">Με την αποσύνδεση του λογαριασμού <ph name="USERNAME" />, θα διαγραφεί το ιστορικό, οι σελιδοδείκτες, οι ρυθμίσεις σας και άλλα δεδομένα zdx που έχουν αποθηκευτεί σε αυτήν τη συσκευή. Τα δεδομένα που έχουν αποθηκευτεί στον Λογαριασμό σας zdx δεν θα διαγραφούν και μπορείτε να τα διαχειριστείτε μέσω του <ph name="GOOGLE_DASHBOARD_LINK" />Πίνακα ελέγχου zdx<ph name="END_GOOGLE_DASHBOARD_LINK" />.</translation>
<translation id="9190841055450128916">zdx (mDNS-In)</translation>
<translation id="9197815481970649201">Έχετε συνδεθεί στο zdx</translation>
<translation id="93478295209880648">Το zdx μπορεί να μην λειτουργεί σωστά, επειδή δεν υποστηρίζεται πια σε Windows XP και Windows Vista</translation>
<translation id="95514773681268843">Το <ph name="DOMAIN" /> απαιτεί να διαβάσετε και να αποδεχτείτε τους ακόλουθους Όρους Παροχής Υπηρεσιών πριν από τη χρήση αυτής της συσκευής. Οι συγκεκριμένοι όροι δεν επεκτείνουν, τροποποιούν ή περιορίζουν τους όρους του zdx OS.</translation>
<translation id="985602178874221306">Οι συντάκτες του zdx</translation>
</translationbundle>