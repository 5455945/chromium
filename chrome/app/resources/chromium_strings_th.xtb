<translation id="4567424176335768812">คุณกำลังลงชื่อเข้าใช้เป็น <ph name="USER_EMAIL_ADDRESS" /> ตอนนี้คุณสามารถเข้าถึงบุ๊กมาร์ก ประวัติการเข้าชม และการตั้งค่าอื่นๆ บนอุปกรณ์ทั้งหมดที่ลงชื่อเข้าใช้</translation>
<translation id="459535195905078186">แอป zdx</translation>
<translation id="4621240073146040695">การอัปเดตใกล้จะเสร็จเรียบร้อยแล้ว เปิด zdx อีกครั้งเพื่อให้การอัปเดตเสร็จสิ้น</translation>
<translation id="4677944499843243528">ดูเหมือนว่าโปรไฟล์กำลังถูกใช้งานโดยกระบวนการอื่นของ zdx (<ph name="PROCESS_ID" />) บนคอมพิวเตอร์อีกเครื่อง (<ph name="HOST_NAME" />) zdx ล็อกโปรไฟล์ไว้เพื่อไม่ให้โปรไฟล์เกิดความเสียหาย หากคุณมั่นใจว่าไม่มีกระบวนการอื่นใดกำลังใช้โปรไฟล์นี้อยู่ คุณสามารถปลดล็อกโปรไฟล์และเปิด zdx ใหม่</translation>
<translation id="469338717132742108">รับความช่วยเหลือเกี่ยวกับ zdx OS</translation>
<translation id="4708774505295300557">ก่อนหน้านี้มีผู้ลงชื่อเข้าใช้ zdx ในคอมพิวเตอร์นี้ด้วยชื่อ <ph name="ACCOUNT_EMAIL_LAST" /> โปรดสร้างผู้ใช้ zdx ใหม่เพื่อเก็บข้อมูลแยก</translation>
<translation id="4714956846925717402">ใช้ zdx ได้เร็วขึ้น</translation>
<translation id="4746050847053251315">ปิด zdx ใช่ไหม</translation>
<translation id="4888717733111232871">กฎขาเข้าสำหรับ zdx เพื่ออนุญาตการเข้าชมแบบ mDNS</translation>
<translation id="4943838377383847465">zdx กำลังอยู่ในโหมดทำงานในพื้นหลัง</translation>
<translation id="4987820182225656817">ผู้เยี่ยมชมสามารถใช้ zdx โดยไม่ทิ้งร่องรอยไว้</translation>
<translation id="4994636714258228724">เพิ่มตัวคุณเองใน zdx</translation>
<translation id="5021854341188256296">{0,plural, =0{มีอัปเดต zdx OS พร้อมให้ใช้งาน}=1{มีอัปเดต zdx OS พร้อมให้ใช้งาน}other{อัปเดต zdx OS พร้อมให้ใช้งานมาแล้ว # วัน}}</translation>
<translation id="5032989939245619637">บันทึกรายละเอียดใน zdx</translation>
<translation id="5045248521775609809">ใช้ zdx ได้ทุกที่</translation>
<translation id="5116586539350239523">zdx จะเก็บรายละเอียดส่วนตัวของคุณอย่างปลอดภัย คุณจึงไม่จำเป็นต้องพิมพ์รายละเอียดเหล่านั้นอีกครั้ง</translation>
<translation id="5277894862589591112">เปิด zdx ขึ้นมาใหม่เพื่อให้การเปลี่ยนแปลงมีผล</translation>
<translation id="5358375970380395591">คุณกำลังลงชื่อเข้าใช้ด้วยบัญชีที่จัดการ และให้การควบคุมระดับผู้ดูแลระบบของบัญชีดังกล่าวเหนือโปรไฟล์ zdx ของคุณ ข้อมูล zdx เช่น แอป บุ๊กมาร์ก ประวัติการเข้าชม รหัสผ่าน และการตั้งค่าอื่นๆ จะเชื่อมโยงอย่างถาวรกับ <ph name="USER_NAME" /> คุณจะสามารถลบข้อมูลนี้ผ่านทางแผงควบคุมบัญชี zdx แต่คุณจะไม่สามารถเชื่อมโยงข้อมูลนี้กับบัญชีอื่น <ph name="LEARN_MORE" /></translation>
<translation id="5386450000063123300">กำลังอัปเดต zdx (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="538767207339317086">อนุญาตให้ลงชื่อเข้าใช้ zdx</translation>
<translation id="5398878173008909840">zdx รุ่นใหม่พร้อมให้ใช้งานแล้ว</translation>
<translation id="5416696090975899932">zdx แสดงหน้าตัวอย่างก่อนพิมพ์ไม่ได้หากไม่มีโปรแกรมดู PDF ในตัว</translation>
<translation id="5427571867875391349">ตั้ง zdx เป็นเบราว์เซอร์เริ่มต้นของคุณ</translation>
<translation id="5438241569118040789"><ph name="PAGE_TITLE" /> - zdx เบต้า</translation>
<translation id="5466153949126434691">zdx ทำการอัปเดตโดยอัตโนมัติเพื่อให้คุณมีเวอร์ชันใหม่ล่าสุดเสมอ เมื่อดาวน์โหลดเสร็จ zdx จะรีสตาร์ท และคุณจะสามารถใช้งานได้ทันที</translation>
<translation id="5479196819031988440">zdx OS ไม่สามารถเปิดหน้านี้</translation>
<translation id="5480860683791598150">zdx ต้องการสิทธิ์เข้าถึงตำแหน่งของคุณเพื่อแชร์ตำแหน่งกับเว็บไซต์นี้</translation>
<translation id="549669000822060376">โปรดรอขณะที่ zdx ติดตั้งการอัปเดตระบบล่าสุด</translation>
<translation id="5529843986978123325">{0,plural, =1{zdx OS จะรีสตาร์ทใน 1 นาที}other{zdx OS จะรีสตาร์ทใน # นาที}}</translation>
<translation id="5631814766731275228">ชื่อและภาพโปรไฟล์ zdx</translation>
<translation id="5634636535844844681">zdx ต้องใช้ Windows 7 ขึ้นไป</translation>
<translation id="5680901439334282664">ลงชื่อเข้าใช้ zdx</translation>
<translation id="5698481217667032250">แสดง zdx ในภาษานี้</translation>
<translation id="5712253116097046984">ผู้ดูแลระบบขอให้คุณรีสตาร์ท zdx OS เพื่อใช้การอัปเดตนี้</translation>
<translation id="5726838626470692954">ผู้จัดการต้องนำคุณออกแล้วเพิ่มคุณกลับเข้าไปใน zdx ใหม่</translation>
<translation id="5768914737813585044">แสดงระบบปฏิบัติการ zdx ในภาษานี้</translation>
<translation id="5796460469508169315">zdx เกือบจะพร้อมใช้งานแล้ว</translation>
<translation id="5820394555380036790">zdx OS</translation>
<translation id="5862307444128926510">ยินดีต้อนรับสู่ zdx</translation>
<translation id="5877064549588274448">เปลี่ยนช่องแล้ว รีสตาร์ทอุปกรณ์เพื่อใช้การเปลี่ยนแปลง</translation>
<translation id="5895138241574237353">ปิดแล้วเปิดอีกครั้ง</translation>
<translation id="5902536751647951209">การรับรองการตรวจสอบสิทธิ์ล้มเหลว โปรดลงชื่อเข้าใช้ zdx อีกครั้ง หรือสอบถามข้อมูลเพิ่มเติมจากผู้ดูแลระบบ <ph name="ADDITIONAL_EXPLANATION" /></translation>
<translation id="5906655207909574370">การอัปเดตใกล้จะเสร็จเรียบร้อยแล้ว รีสตาร์ทอุปกรณ์เพื่อให้การอัปเดตเสร็จสิ้น</translation>
<translation id="5987687638152509985">อัปเดต zdx เพื่อเริ่มการซิงค์</translation>
<translation id="6040143037577758943">ปิด</translation>
<translation id="6055895534982063517">มี zdx รุ่นใหม่ให้ใช้งานแล้วและทำงานได้เร็วกว่าเดิม</translation>
<translation id="6063093106622310249">&amp;เปิดใน zdx</translation>
<translation id="6072279588547424923">เพิ่ม <ph name="EXTENSION_NAME" /> ลงใน zdx แล้ว</translation>
<translation id="608189560609172163">zdx ไม่สามารถซิงค์ข้อมูลของคุณเนื่องจากข้อผิดพลาดในการลงชื่อเข้าใช้</translation>
<translation id="6096348254544841612">ปรับแต่งและควบคุม zdx มีการอัปเดต</translation>
<translation id="6120345080069858279">zdx จะบันทึกรหัสผ่านนี้ในบัญชี zdx คุณจะได้ไม่ต้องจำรหัสผ่านเอง</translation>
<translation id="6129621093834146363"><ph name="FILE_NAME" /> เป็นอันตราย zdx จึงบล็อกไว้</translation>
<translation id="620022061217911843">ผู้ดูแลระบบต้องการให้คุณรีสตาร์ท zdx OS เพื่อใช้การอัปเดต</translation>
<translation id="6212496753309875659">คอมพิวเตอร์เครื่องนี้ติดตั้ง zdx รุ่นที่ใหม่กว่าอยู่แล้ว ถ้าซอฟต์แวร์ไม่ทำงาน โปรดถอนการติดตั้ง zdx และลองอีกครั้ง</translation>
<translation id="6248213926982192922">ทำให้ zdx เป็นเบราว์เซอร์เริ่มต้น</translation>
<translation id="6268381023930128611">ต้องการออกจาก zdx ใช่ไหม</translation>
<translation id="6295779123002464101"><ph name="FILE_NAME" /> อาจเป็นอันตราย zdx จึงบล็อกไว้</translation>
<translation id="6309712487085796862">zdx ใช้กล้องของคุณอยู่</translation>
<translation id="6333502561965082103">zdx กำลังดำเนินการอย่างอื่นอยู่ โปรดลองอีกครั้งในภายหลัง</translation>
<translation id="6334986366598267305">ตอนนี้การใช้ zdx กับบัญชี zdx ของคุณและบนคอมพิวเตอร์ที่ใช้ร่วมกันทำได้ง่ายกว่าเดิม</translation>
<translation id="6373523479360886564">คุณแน่ใจหรือไม่ว่าต้องการถอนการติดตั้ง zdx</translation>
<translation id="6394232988457703198">คุณควรรีสตาร์ท zdx เลย</translation>
<translation id="6400072781405947421">zdx อาจทำงานไม่ถูกต้องเนื่องจากไม่รองรับ Mac OS X 10.9 แล้ว</translation>
<translation id="6403826409255603130">zdx เป็นเว็บเบราว์เซอร์ที่เรียกใช้หน้าเว็บและแอปพลิเคชันด้วยความเร็วสูง มีความรวดเร็ว เสถียร และง่ายในการใช้งาน เรียกดูเว็บได้อย่างปลอดภัยมากขึ้นด้วยการป้องกันมัลแวร์และฟิชชิงที่สร้างอยู่ภายใน zdx</translation>
<translation id="641451971369018375">สื่อสารกับ zdx เพื่อปรับปรุงการท่องเว็บและ zdx</translation>
<translation id="6457450909262716557">{SECONDS,plural, =1{zdx จะรีสตาร์ทใน 1 วินาที}other{zdx จะรีสตาร์ทใน # วินาที}}</translation>
<translation id="6475912303565314141">อีกทั้งยังควบคุมหน้าที่จะแสดงเมื่อคุณเปิด zdx ด้วย</translation>
<translation id="6485906693002546646">คุณกำลังใช้ <ph name="PROFILE_EMAIL" /> ในการซิงค์ข้อมูลใน zdx หากต้องการอัปเดตค่ากำหนดการซิงค์หรือใช้ zdx โดยไม่มีบัญชี zdx โปรดไปที่ <ph name="SETTINGS_LINK" /></translation>
<translation id="6510925080656968729">ถอนการติดตั้ง zdx</translation>
<translation id="6570579332384693436">zdx จะส่งข้อความที่คุณพิมพ์ในช่องข้อความไปยัง zdx เพื่อแก้ไขข้อผิดพลาดของการสะกดคำ</translation>
<translation id="6598877126913850652">ไปที่การตั้งค่าการแจ้งเตือน zdx</translation>
<translation id="6676384891291319759">เข้าถึงอินเทอร์เน็ต</translation>
<translation id="6717134281241384636">โปรไฟล์ของคุณไม่สามารถใช้ได้เนื่องจากมาจาก zdx รุ่นใหม่

ฟีเจอร์บางประการอาจไม่มี โปรดระบุไดเรกทอรีโปรไฟล์อื่น หรือใช้ zdx รุ่นใหม่</translation>
<translation id="6734080038664603509">อัปเดต &amp;zdx</translation>
<translation id="6734291798041940871">มีการติดตั้ง zdx สำหรับผู้ใช้ทุกคนบนคอมพิวเตอร์ของคุณแล้ว</translation>
<translation id="6810143991807788455">ช่วยให้ zdx ดียิ่งขึ้นด้วยการรายงานการตั้งค่าปัจจุบัน</translation>
<translation id="6857782730669500492">zdx - <ph name="PAGE_TITLE" /></translation>
<translation id="6863361426438995919">zdx Pay (คัดลอกไปยัง zdx)</translation>
<translation id="6893813176749746474">zdx ได้รับการอัปเดตแล้ว แต่คุณไม่ได้ใช้งานมาไม่ต่ำกว่า 30 วันแล้ว</translation>
<translation id="6964305034639999644">เปิดลิงก์ในหน้าต่างที่ไม่ระบุตัวตนของ zdx</translation>
<translation id="6970811910055250180">กำลังอัปเดตอุปกรณ์ของคุณ...</translation>
<translation id="6990124437352146030">zdx ต้องการสิทธิ์เข้าถึงไมโครโฟนของคุณสำหรับเว็บไซต์นี้</translation>
<translation id="705851970750939768">อัปเดต zdx</translation>
<translation id="7066436765290594559">zdx OS ไม่สามารถซิงค์ข้อมูลของคุณ โปรดอัปเดตข้อความรหัสผ่านสำหรับการซิงค์</translation>
<translation id="7162152143154757523">zdx สามารถให้บริการตรวจสอบการสะกดที่ชาญฉลาดมากขึ้นโดยการส่งสิ่งที่คุณพิมพ์ในเบราว์เซอร์ไปยังเซิร์ฟเวอร์ของ zdx คุณจึงสามารถใช้เทคโนโลยีตรวจสอบการสะกดแบบเดียวกันกับที่ zdx Search ใช้</translation>
<translation id="7196312274710523067">เปิด zdx ไม่ได้ โปรดลองอีกครั้ง</translation>
