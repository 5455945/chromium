<translation id="7449453770951226939"><ph name="PAGE_TITLE" /> - zdx Dev</translation>
<translation id="7451052299415159299">zdx ต้องการสิทธิ์เข้าถึงกล้องถ่ายรูปของคุณสำหรับเว็บไซต์นี้</translation>
<translation id="7471302858145901434">{0,plural, =1{รีสตาร์ท zdx OS ภายใน 1 วัน}other{รีสตาร์ท zdx OS ภายใน # วัน}}</translation>
<translation id="7483335560992089831">ไม่สามารถติดตั้ง zdx รุ่นเดียวกับที่กำลังใช้งานอยู่ในขณะนี้ โปรดปิด zdx และลองอีกครั้ง</translation>
<translation id="7549178288319965365">เกี่ยวกับ zdx OS</translation>
<translation id="7577193603922410712">ระบบเพิ่งนำการอัปเดตความปลอดภัยฉบับพิเศษไปใช้สำหรับ zdx คุณควรรีสตาร์ทโปรแกรมเพื่อให้มีผลใช้งาน (เราจะคืนค่าแท็บให้คุณ)</translation>
<translation id="761356813943268536">zdx ใช้กล้องและไมโครโฟนของคุณอยู่</translation>
<translation id="7617377681829253106">zdx ดีขึ้นกว่าเดิม</translation>
<translation id="7686590090926151193">zdx ไม่ใช่เบราว์เซอร์เริ่มต้น</translation>
<translation id="7689606757190482937">ซิงค์และปรับเปลี่ยน zdx ในอุปกรณ์ต่างๆ</translation>
<translation id="7729447699958282447">zdx ไม่สามารถซิงค์ข้อมูลของคุณเนื่องจากไม่สามารถใช้การซิงค์กับโดเมนของคุณ</translation>
<translation id="7745317241717453663">การดำเนินการนี้จะลบข้อมูลการท่องเว็บออกจากอุปกรณ์นี้ หากต้องการดึงข้อมูลภายหลัง ให้ลงชื่อเข้าใช้ zdx ด้วย <ph name="USER_EMAIL" /></translation>
<translation id="7747138024166251722">โปรแกรมติดตั้งสร้างไดเรกทอรีชั่วคราวไม่ได้ โปรดตรวจสอบพื้นที่ดิสก์ว่างและการอนุญาตให้ติดตั้งซอฟต์แวร์</translation>
<translation id="7756122083761163394">ระบบจะลบข้อมูลการท่องเว็บของบุคคลนี้ออกจากอุปกรณ์นี้ หากต้องการกู้ข้อมูลคืน ให้ลงชื่อเข้าใช้ Chrome ในชื่อ $2</translation>
<translation id="7773960292263897147">คำเตือน: zdx ไม่สามารถป้องกันไม่ให้ส่วนขยายบันทึกประวัติการท่องเว็บได้ หากคุณต้องการปิดใช้ส่วนขยายนี้ในโหมดไม่ระบุตัวตน ให้ยกเลิกการเลือกตัวเลือกนี้</translation>
<translation id="7774736947049807614">การรับรองการตรวจสอบสิทธิ์ล้มเหลว โปรดลงชื่อเข้าใช้ zdx ด้วย <ph name="USER_NAME" /> อีกครั้ง หรือสอบถามข้อมูลเพิ่มเติมจากผู้ดูแลระบบ <ph name="ADDITIONAL_EXPLANATION" /></translation>
<translation id="7790626492778995050"><ph name="PAGE_TITLE" /> - zdx Canary</translation>
<translation id="7867198900892795913">zdx อัปเดตเป็นเวอร์ชันล่าสุดไม่ได้ คุณจึงไม่ได้รับฟีเจอร์ใหม่และการแก้ไขด้านความปลอดภัย</translation>
<translation id="7901117350626490574">อัปเดตใหม่ของ zdx พร้อมให้ใช้งานแล้วและระบบจะใช้อัปเดตดังกล่าวเมื่อคุณเปิด zdx ขึ้นมาใหม่</translation>
<translation id="7937630085815544518">คุณเคยลงชื่อเข้าใช้ zdx ในชื่อ <ph name="USER_EMAIL_ADDRESS" /> โปรดใช้บัญชีเดิมเพื่อลงชื่อเข้าใช้อีกครั้ง</translation>
<translation id="7962572577636132072">zdx จะอัปเดตโดยอัตโนมัติเพื่อให้คุณได้ใช้เวอร์ชันใหม่ล่าสุดอยู่เสมอ</translation>
<translation id="7975919845073681630">นี่เป็นการติดตั้ง zdx แบบสำรอง และไม่สามารถใช้เป็นเบราว์เซอร์เริ่มต้นของคุณ</translation>
<translation id="7979877361127045932">ซ่อนในเมนู zdx</translation>
<translation id="8013436988911883588">เมื่อ zdx มีสิทธิ์การเข้าถึงแล้ว เว็บไซต์จะขอสิทธิ์การเข้าถึงจากคุณได้</translation>
<translation id="8030318113982266900">กำลังอัปเดตอุปกรณ์ของคุณไปยังช่อง <ph name="CHANNEL_NAME" />...</translation>
<translation id="8157153840442649507">zdx แสดงในภาษานี้</translation>
<translation id="81770708095080097">ไฟล์นี้อันตราย zdx จึงบล็อกไว้</translation>
<translation id="8222496066431494154">ติดตั้ง zdx ในโทรศัพท์ เราจะส่ง SMS ไปยังหมายเลขโทรศัพท์สำหรับการกู้คืนบัญชีของคุณ: <ph name="PHONE_NUMBER" /></translation>
<translation id="825412236959742607">หน้านี้ใช้หน่วยความจำมากเกินไป Chrome จึงนำเนื้อหาบางส่วนออก</translation>
<translation id="8269379391216269538">ช่วยปรับปรุง zdx ให้ดีขึ้น</translation>
<translation id="8290862415967981663">ไฟล์นี้อาจเป็นอันตราย zdx จึงบล็อกไว้</translation>
<translation id="8330519371938183845">ลงชื่อเข้าใช้เพื่อซิงค์และปรับเปลี่ยน zdx ในอุปกรณ์ต่างๆ</translation>
<translation id="8340674089072921962"><ph name="USER_EMAIL_ADDRESS" /> ใช้ zdx อยู่ก่อนหน้านี้</translation>
<translation id="8375950122744241554">คุณจะใช้โปรไฟล์ผู้ใช้ภายใต้การดูแลไม่ได้อีกแล้วโดยเริ่มตั้งแต่ zdx 70 เป็นต้นไป</translation>
<translation id="8379713241968949941">{0,plural, =1{zdx จะเปิดขึ้นมาใหม่ภายใน 1 ชั่วโมง}other{zdx จะเปิดขึ้นมาใหม่ภายใน # ชั่วโมง}}</translation>
<translation id="8453117565092476964">การเก็บข้อมูลของโปรแกรมติดตั้งเสียหายหรือไม่ถูกต้อง โปรดดาวน์โหลด zdx อีกครั้ง</translation>
<translation id="8493179195440786826">zdx ล้าสมัย</translation>
<translation id="85843667276690461">รับความช่วยเหลือเกี่ยวกับการใช้ zdx</translation>
<translation id="8586442755830160949">ลิขสิทธิ์ <ph name="YEAR" /> The zdx Authors สงวนลิขสิทธิ์</translation>
<translation id="8599548569518771270">{0,plural, =0{zdx OS จะรีสตาร์ทตอนนี้}=1{zdx OS จะรีสตาร์ทใน 1 วินาที}other{zdx OS จะรีสตาร์ทใน # วินาที}}</translation>
<translation id="8619360774459241877">กำลังเปิด zdx...</translation>
<translation id="8621669128220841554">การติดตั้งล้มเหลวเนื่องจากเกิดข้อผิดพลาดที่ไม่ระบุ โปรดดาวน์โหลด zdx อีกครั้ง</translation>
<translation id="8667808506758191620"><ph name="DEVICE_TYPE" /> ของคุณเป็นเวอร์ชันล่าสุดแล้ว</translation>
<translation id="8697124171261953979">อีกทั้งยังควบคุมหน้าที่จะแสดงเมื่อคุณเปิด zdx หรือทำการค้นหาจากแถบอเนกประสงค์ด้วย</translation>
<translation id="8704119203788522458">นี่คือ zdx ของคุณ</translation>
<translation id="8796602469536043152">zdx ต้องการสิทธิ์เข้าถึงไมโครโฟนและกล้องถ่ายรูปของคุณสำหรับเว็บไซต์นี้</translation>
<translation id="8803635938069941624">ข้อกำหนดของ zdx OS</translation>
<translation id="8821041990367117597">zdx ไม่สามารถซิงค์ข้อมูลของคุณเนื่องจากรายละเอียดการลงชื่อเข้าใช้บัญชีของคุณล้าสมัย</translation>
<translation id="8862326446509486874">คุณไม่มีสิทธิ์ในการติดตั้งระดับระบบ ทดลองใช้งานโปรแกรมติดตั้งอีกครั้งโดยกำหนดให้เป็นผู้ดูแลระบบ</translation>
<translation id="8897323336392112261">อีกทั้งยังควบคุมหน้าที่จะแสดงเมื่อคุณเปิด zdx หรือคลิกปุ่ม "หน้าแรก"</translation>
<translation id="8907580949721785412">zdx กำลังพยายามแสดงรหัสผ่าน พิมพ์รหัสผ่าน Windows ของคุณเพื่อแสดงรหัสผ่าน</translation>
<translation id="8941642502866065432">อัปเดต zdx ไม่ได้</translation>
<translation id="8974095189086268230">zdx Chrome OS เกิดขึ้นได้ด้วยการสนับสนุนจาก<ph name="BEGIN_LINK_CROS_OSS" />ซอฟต์แวร์โอเพนซอร์ส<ph name="END_LINK_CROS_OSS" />อื่นๆ</translation>
<translation id="8985587603644336029">ก่อนหน้านี้มีผู้ลงชื่อเข้าใช้ zdx บนคอมพิวเตอร์นี้ในชื่อ <ph name="ACCOUNT_EMAIL_LAST" /> หากนั่นไม่ใช่บัญชีของคุณ ให้สร้างผู้ใช้ zdx ใหม่เพื่อเก็บข้อมูลแยก

การลงชื่อเข้าใช้ต่อไปจะรวมข้อมูล zdx เช่น บุ๊กมาร์ก ประวัติการเข้าชม และการตั้งค่าอื่นๆ เข้ากับ <ph name="ACCOUNT_EMAIL_NEW" /></translation>
<translation id="9013087743919948559">เพิ่มลงใน zdx</translation>
<translation id="9019929317751753759">เพื่อให้ zdx ปลอดภัยขึ้น เราได้ปิดส่วนขยายต่อไปนี้ซึ่งไม่ได้แสดงอยู่ใน <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> และอาจมีการเพิ่มเข้ามาโดยที่คุณไม่รู้ตัว</translation>
<translation id="9022552996538154597">ลงชื่อเข้าใช้ zdx</translation>
<translation id="9025992965467895364">หน้านี้ใช้หน่วยความจำมากเกินไป zdx จึงหยุดหน้าชั่วคราว</translation>
<translation id="9036189287518468038">zdx App Launcher</translation>
<translation id="9089354809943900324">zdx ล้าสมัย</translation>
<translation id="91086099826398415">เปิดลิงก์ใน zdx แท็บใหม่</translation>
<translation id="911206726377975832">ลบข้อมูลการท่องเว็บด้วยหรือไม่</translation>
<translation id="918373042641772655">การยกเลิกการเชื่อมต่อกับ <ph name="USERNAME" /> จะล้างประวัติการเข้าชม บุ๊กมาร์ก การตั้งค่า และข้อมูลอื่นๆ ของ zdx ที่เก็บไว้ในอุปกรณ์นี้ ข้อมูลที่เก็บไว้ในบัญชี zdx ของคุณจะไม่ถูกล้างและสามารถจัดการได้บน <ph name="GOOGLE_DASHBOARD_LINK" />zdx แดชบอร์ด<ph name="END_GOOGLE_DASHBOARD_LINK" /></translation>
<translation id="9190841055450128916">zdx (mDNS-In)</translation>
<translation id="9197815481970649201">คุณได้ลงชื่อเข้าใช้ zdx แล้ว</translation>
<translation id="93478295209880648">zdx อาจทำงานไม่ถูกต้องเพราะไม่รองรับ Windows XP หรือ Windows Vista อีกต่อไป</translation>
<translation id="95514773681268843"><ph name="DOMAIN" /> กำหนดว่าคุณต้องอ่านและยอมรับข้อกำหนดในการให้บริการต่อไปนี้ก่อนใช้อุปกรณ์นี้ ข้อกำหนดเหล่านี้ไม่ขยาย แก้ไข หรือจำกัดข้อกำหนดของ zdx OS</translation>
<translation id="985602178874221306">The zdx Authors</translation>
</translationbundle>